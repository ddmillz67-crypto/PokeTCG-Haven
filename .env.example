# Kopieer naar .env en vul in. Zet .env NOOIT in git.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Tot en met welke stap de bot de server inricht (0-27), en of hij alleen laat zien wat hij zou doen.
SETUP_TOT_STAP=0
SETUP_DRY_RUN=1
# Waar de database staat. Op Railway: een volume, bijvoorbeeld /data.
DATA_DIR=data
# Whop-links voor de Store (leeg = knop toont "binnenkort").
WHOP_SNIPER_URL=
WHOP_FOUNDER_URL=
WHOP_ELITE_URL=
